HOST_STAGING := /lede/netos-23/staging_dir/host

CC := cc

INCLUDES := -I$(HOST_STAGING)/include
CFLAGS := -Wall -Werror=format-security $(INCLUDES)

LDFLAGS := -L$(HOST_STAGING)/lib

LIBS := \
	-Wl,-Bstatic \
	-lbsd \
	-lblobmsg_json \
	-ljson-c \
	-lubox \
	-Wl,-Bdynamic

release: clean
	$(CC) $(CFLAGS) -s sandbox.c -o converter $(LDFLAGS) $(LIBS)

debug: clean
	$(CC) $(CFLAGS) -g sandbox.c -o converter $(LDFLAGS) $(LIBS)

clean:
	rm -rf sandbox *~